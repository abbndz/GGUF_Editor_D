  end;

  // Remplissage des listes
  for i := 0 to kmap_size - 1 do
  begin
    if kmap_iq2xs[i] >= 0 then
      Continue;

    posPtr := @pos[0];
    for k := 0 to 7 do
    begin
      l := (i shr (2 * k)) and $3;
