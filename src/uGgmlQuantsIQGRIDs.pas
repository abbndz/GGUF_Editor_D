  num_neighbors := ANeighbors[0];
  Assert(num_neighbors > 0);
  best_d2 := Single.MaxValue;
  grid_index := -1;

  for j := 1 to num_neighbors do
  begin
    pg := PShortInt(PByte(AGrid) + ANeighbors[j] * 4);
    d2 := 0.0;
    for i := 0 to 3 do
    begin
      q := pg[i];
      diff := AScale * q - AXVal[i];
      d2 := d2 + AWeight[i] * diff * diff;
    end;
    if d2 < best_d2 then
    begin
      best_d2 := d2;
      grid_index := ANeighbors[j];
    end;
  end;

  Assert(grid_index >= 0);
  pg := PShortInt(PByte(AGrid) + grid_index * 4);
  for i := 0 to 3 do
    AL[i] := (pg[i] - 1) div 2;

  Result := grid_index;
end;

function FindBestNeighbourIQ2(const ANeighbors: PUInt16; const AGrid: PUInt64; const AXVal: PSingle; const AWeight:
  PSingle; AScale: Single; AL: PShortInt): Integer;
var
  num_neighbors, j, i, grid_index: Integer;
  best_d2, d2, q, diff: Single;
  pg: PShortInt;
begin
  num_neighbors := ANeighbors[0];
  Assert(num_neighbors > 0);
  best_d2 := Single.MaxValue;
  grid_index := -1;

  for j := 1 to num_neighbors do
  begin
    pg := PShortInt(PByte(AGrid) + ANeighbors[j] * 8);
    d2 := 0.0;
    for i := 0 to 7 do
    begin
      q := pg[i];
      diff := AScale * q - AXVal[i];
      d2 := d2 + AWeight[i] * diff * diff;
    end;
    if d2 < best_d2 then
    begin
      best_d2 := d2;
      grid_index := ANeighbors[j];
    end;
  end;

  Assert(grid_index >= 0);
  pg := PShortInt(PByte(AGrid) + grid_index * 8);
  for i := 0 to 7 do
    AL[i] := (pg[i] - 1) div 2;

  Result := grid_index;
end;

