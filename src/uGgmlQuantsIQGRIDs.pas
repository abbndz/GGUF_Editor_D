function CmpValIdx(const Left, Right: TValIdx): Integer; inline;
begin
  if Left.v < Right.v then
    Result := -1
  else if Left.v > Right.v then
    Result := 1
  else if Left.i < Right.i then
    Result := -1
  else if Left.i > Right.i then
    Result := 1
  else
    Result := 0;
end;

function CompareDist(const Left, Right: TDistEntry): Integer; inline;
begin
  if Left.dist2 < Right.dist2 then
    Result := -1
  else if Left.dist2 > Right.dist2 then
    Result := 1
  else if Left.grid_idx < Right.grid_idx then
    Result := -1
  else if Left.grid_idx > Right.grid_idx then
    Result := 1
  else
    Result := 0;
end;

procedure SortDistEntriesBucket(var A: array of TDistEntry; GridSize: Integer; MaxDist: Integer);
const
  MAX_BUCKET = 1023;
var
  Counts: array[0..MAX_BUCKET] of Integer;
  Tmp: array[0..2047] of TDistEntry;
  i, d, pos, total: Integer;
begin
  if GridSize <= 1 then
    Exit;

  // Sécurité : si les hypothèses de taille sont dépassées, on retombe sur le tri générique.
  if (GridSize > Length(Tmp)) or (MaxDist > MAX_BUCKET) then
  begin
    TArray.Sort<TDistEntry>(A, TComparer<TDistEntry>.Construct(CompareDist));
    Exit;
  end;

  FillChar(Counts[0], (MaxDist + 1) * SizeOf(Counts[0]), 0);

  // Compter les distances.
  for i := 0 to GridSize - 1 do
  begin
    d := A[i].dist2;
    if (d < 0) or (d > MaxDist) then
    begin
      // Distance impossible avec les hypothèses : sécurité.
      TArray.Sort<TDistEntry>(A, TComparer<TDistEntry>.Construct(CompareDist));
      Exit;
    end;
    Inc(Counts[d]);
  end;

  // Positions de départ pour chaque distance.
  total := 0;
  for d := 0 to MaxDist do
  begin
    pos := Counts[d];
    Counts[d] := total;
    total := total + pos;
  end;

  // Sortie stable : l'ordre d'entrée est l'ordre croissant des grid_idx.
  for i := 0 to GridSize - 1 do
  begin
    d := A[i].dist2;
    Tmp[Counts[d]] := A[i];
    Inc(Counts[d]);
  end;

  Move(Tmp[0], A[0], GridSize * SizeOf(TDistEntry));
end;


// ========================= MEILLEUR VOISIN (grille 8D int64) ================
// Reproduction de iq2_find_best_neighbour() du C (partagee IQ2_*).
function FindBestNeighbourIQ2xxs(const Neighbours, Grid: Pointer; xval, weight: PSingle; scale: Single; l: PShortInt):
  Integer;
var
  pnb: PUInt16;
  num_neighbors, j, i, grid_index: Integer;
  best_d2, d2, q, diff: Single;
  pg: PShortInt;
begin
  pnb := PUInt16(Neighbours);
  num_neighbors := pnb[0];
  Assert(num_neighbors > 0, 'IQ2xxsFindBestNeighbour: liste de voisins vide');
  best_d2 := Single.MaxValue;
  grid_index := -1;

  for j := 1 to num_neighbors do
  begin
    pg := PShortInt(PByte(Grid) + pnb[j] * 8);
    d2 := 0.0;
    for i := 0 to 7 do
    begin
      q := pg[i];
      diff := scale * q - xval[i];
      d2 := d2 + weight[i] * diff * diff;
    end;
    if d2 < best_d2 then
    begin
      best_d2 := d2;
      grid_index := pnb[j];
    end;
  end;

  Assert(grid_index >= 0);
  pg := PShortInt(PByte(Grid) + grid_index * 8);
  for i := 0 to 7 do
    l[i] := ShortInt((pg[i] - 1) div 2);

  Result := grid_index;
end;

