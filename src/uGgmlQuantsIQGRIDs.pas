    for j := 0 to grid_size - 1 do
    begin
      if dist2[j].dist2 > cur_d2 then
      begin
        if nhave = nwant then
          Break;
        cur_d2 := dist2[j].dist2;
        Inc(nhave);
      end;
      Inc(n);
    end;

    n_per_i[i] := n;
    Inc(num_neighbors, n);
  end;

  // Prefix-sum des offsets + allocation
  SetLength(offsets, kmap_size);
  SetLength(kneighbors_q2xxs, num_neighbors + num_not_in_map);

  counter := 0;
  for i := 0 to kmap_size - 1 do
  begin
    if kmap_q2xxs[i] >= 0 then
    begin
      offsets[i] := -1;
      Continue;
    end;
    offsets[i] := counter;
    counter := counter + 1 + n_per_i[i];
  end;

  // Pass 3 : remplissage des listes de voisins
  for i := 0 to kmap_size - 1 do
  begin
    if kmap_q2xxs[i] >= 0 then
      Continue;

    posPtr := @pos[0];
    for k := 0 to 7 do
    begin
      l := (i shr (2 * k)) and $3;
      posPtr[k] := 2 * l + 1;
    end;

    for j := 0 to grid_size - 1 do
    begin
      pg := PShortInt(PByte(@kgrid_q2xxs[j]));
      d2 := 0;
      for k := 0 to 7 do
        d2 := d2 + (pg[k] - pos[k]) * (pg[k] - pos[k]);
      dist2[j].dist2 := d2;
      dist2[j].grid_idx := j;
    end;

    //TArray.Sort<TDistEntry>(dist2, TComparer<TDistEntry>.Construct(CompareDist));
    SortDistEntriesBucket(dist2, grid_size, 288);

    local_counter := offsets[i];
    kmap_q2xxs[i] := -(local_counter + 1);

    cur_d2 := dist2[0].dist2;
    start_idx := local_counter;
    Inc(local_counter);

    n := 0;
    nhave := 1;
    for j := 0 to grid_size - 1 do
    begin
      if dist2[j].dist2 > cur_d2 then
      begin
        if nhave = nwant then
          Break;
        cur_d2 := dist2[j].dist2;
        Inc(nhave);
      end;
      kneighbors_q2xxs[local_counter] := dist2[j].grid_idx;
      Inc(local_counter);
      Inc(n);
    end;
    kneighbors_q2xxs[start_idx] := n;
  end;

  SetLength(n_per_i, 0);
  SetLength(offsets, 0);
  iq2xxs_initialized := True;
end;

// ==================== INITIALISATION GRILLE IQ3_XXS (256) ===================
procedure InitIQ3XXSGrid;
const
  grid_size = GRID_IQ3_XXS_SIZE;
  kmap_size = KMAP_IQ3_SIZE;
  nwant = 2;
var
  k, i, j, l, index, q: Integer;
  n_per_i, offsets: TArray<Integer>;
  dist2: array of TDistEntry;
  pos: array[0..3] of ShortInt;
  pg, posPtr: PShortInt;
  d2, cur_d2, nhave, n, counter, local_counter, start_idx: Integer;
  num_neighbors, num_not_in_map: Integer;
  Grid, lattice: PUInt32;
  aux32: UInt32;
  aux8: PByte;
  mapL: array[Byte] of Integer;
  learned: array[0..7] of Byte;
  nLearned, value: Integer;
  ucode: UInt16;
  seen: array[0..KMAP_IQ3_SIZE - 1] of Boolean;
  GRID256OK: Boolean;
begin
  if iq3xxs_initialized then
    Exit;

  Grid := PUInt32(@IQ3XXS_GRID[0]);

  // 0. Niveaux : valeurs distinctes de IQ3XXS_GRID (4,12,20,28,36,44,52,62)
  for i := 0 to High(mapL) do
    mapL[i] := -1;
  nLearned := 0;
  for i := 0 to grid_size - 1 do
  begin
    aux32 := PUInt32(PByte(Grid) + i * 4)^;
    aux8 := PByte(@aux32);
    for k := 0 to 3 do
      if mapL[aux8[k]] < 0 then
      begin
        learned[nLearned] := aux8[k];
        mapL[aux8[k]] := 0;
        Inc(nLearned);
      end;
  end;
  GRID256OK := (nLearned = 8);
  Assert(GRID256OK, 'IQ3XXS_GRID: postulat de niveaux non verifie -> coller kgrid_256 du C');

  TArray.Sort<Byte>(learned);
  for value := 0 to 7 do
    mapL[learned[value]] := value;

  // 1. Grille de recherche (pos = 2*l+1) + kmap
  SetLength(kgrid_q3xxs, grid_size);
  SetLength(kmap_q3xxs, kmap_size);
  for i := 0 to kmap_size - 1 do
    kmap_q3xxs[i] := -1;

  lattice := PUInt32(@kgrid_q3xxs[0]);
  for i := 0 to grid_size - 1 do
  begin
    aux32 := PUInt32(PByte(Grid) + i * 4)^;
    aux8 := PByte(@aux32);
    ucode := 0;
    posPtr := @pos[0];
    for k := 0 to 3 do
    begin
      l := mapL[aux8[k]];
      ucode := ucode or (UInt16(l) shl (3 * k));
      posPtr[k] := 2 * l + 1;
    end;
    PShortInt(PByte(lattice) + i * 4)^ := pos[0];
    PShortInt(PByte(lattice) + i * 4 + 1)^ := pos[1];
    PShortInt(PByte(lattice) + i * 4 + 2)^ := pos[2];
    PShortInt(PByte(lattice) + i * 4 + 3)^ := pos[3];
    kmap_q3xxs[ucode] := i;
  end;

  // Controle de bijectivite (postulat d'isomorphisme)
  for i := 0 to High(seen) do
    seen[i] := False;
  GRID256OK := True;
  for i := 0 to grid_size - 1 do
  begin
    aux32 := PUInt32(PByte(lattice) + i * 4)^;
    aux8 := PByte(@aux32);
    index := 0;
    for k := 0 to 3 do
    begin
      q := (aux8[k] - 1) div 2;
      index := index or (q shl (3 * k));
    end;
    if seen[index] then
      GRID256OK := False;
    seen[index] := True;
    if kmap_q3xxs[index] <> i then
      GRID256OK := False;
  end;
  Assert(GRID256OK, 'IQ3XXS_GRID: index de grille non bijectifs');

  SetLength(dist2, grid_size);
  SetLength(n_per_i, kmap_size);
  num_neighbors := 0;
  num_not_in_map := 0;

  for i := 0 to kmap_size - 1 do
  begin
    if kmap_q3xxs[i] >= 0 then
    begin
      n_per_i[i] := 0;
      Continue;
    end;
    Inc(num_not_in_map);

    posPtr := @pos[0];
    for k := 0 to 3 do
    begin
      l := (i shr (3 * k)) and $7;
      posPtr[k] := 2 * l + 1;
    end;

    for j := 0 to grid_size - 1 do
    begin
      pg := PShortInt(PByte(lattice) + j * 4);
      d2 := 0;
      for k := 0 to 3 do
        d2 := d2 + (pg[k] - pos[k]) * (pg[k] - pos[k]);
      dist2[j].dist2 := d2;
      dist2[j].grid_idx := j;
    end;

    //TArray.Sort<TDistEntry>(dist2, TComparer<TDistEntry>.Construct(CompareDist));
    SortDistEntriesBucket(dist2, grid_size, 784);

    n := 0;
    cur_d2 := dist2[0].dist2;
    nhave := 1;
    for j := 0 to grid_size - 1 do
    begin
      if dist2[j].dist2 > cur_d2 then
      begin
        if nhave = nwant then
          Break;
        cur_d2 := dist2[j].dist2;
        Inc(nhave);
      end;
      Inc(n);
    end;

    n_per_i[i] := n;
    Inc(num_neighbors, n);
  end;

  // Prefix-sum des offsets + allocation
  SetLength(offsets, kmap_size);
  SetLength(kneighbors_q3xxs, num_neighbors + num_not_in_map);

  counter := 0;
  for i := 0 to kmap_size - 1 do
  begin
    if kmap_q3xxs[i] >= 0 then
    begin
      offsets[i] := -1;
      Continue;
    end;
    offsets[i] := counter;
    counter := counter + 1 + n_per_i[i];
  end;

  // Remplissage des listes de voisins
  for i := 0 to kmap_size - 1 do
  begin
    if kmap_q3xxs[i] >= 0 then
      Continue;

    posPtr := @pos[0];
    for k := 0 to 3 do
    begin
      l := (i shr (3 * k)) and $7;
      posPtr[k] := 2 * l + 1;
    end;

    for j := 0 to grid_size - 1 do
    begin
      pg := PShortInt(PByte(lattice) + j * 4);
      d2 := 0;
      for k := 0 to 3 do
        d2 := d2 + (pg[k] - pos[k]) * (pg[k] - pos[k]);
      dist2[j].dist2 := d2;
      dist2[j].grid_idx := j;
    end;

    //TArray.Sort<TDistEntry>(dist2, TComparer<TDistEntry>.Construct(CompareDist));
    SortDistEntriesBucket(dist2, grid_size, 784);

    local_counter := offsets[i];
    kmap_q3xxs[i] := -(local_counter + 1);

    cur_d2 := dist2[0].dist2;
    start_idx := local_counter;
    Inc(local_counter);

    n := 0;
    nhave := 1;
    for j := 0 to grid_size - 1 do
    begin
      if dist2[j].dist2 > cur_d2 then
      begin
        if nhave = nwant then
          Break;
        cur_d2 := dist2[j].dist2;
        Inc(nhave);
      end;
      kneighbors_q3xxs[local_counter] := dist2[j].grid_idx;
      Inc(local_counter);
      Inc(n);
    end;
    kneighbors_q3xxs[start_idx] := n;
  end;

  SetLength(n_per_i, 0);
  SetLength(offsets, 0);
  iq3xxs_initialized := True;
end;

// ==================== INITIALISATION GRILLE IQ1_S / IQ1_M ===================
// Miroir de iq2xs_init_impl(GGML_TYPE_IQ1_S) : kgrid_1bit_2048 -> lattice,
// kmap (43692) + voisins (nwant = 3).  Partagee par IQ1_S et IQ1_M.
//
// OPTIMISATION vs C : on ne visite que les indices dont les 8 champs de 2 bits
// sont dans {0,1,2} (3^8 = 6561 points).  Le quantizer IQ1 ne construit que des
// u avec L in {0,1,2}, donc un champ a 3 n'est jamais recherche ; le C calcule
// ces listes pour rien (et la moitie des composantes de la grille n'utilise que
// l = 0,1,2).  Gain ~ x7 a l'init, contenu des listes strictement identique.
// Les indices "interdits" restent a -1.  Test : (i and (i shr 1)) and $5555
// detecte un champ egal a 3 (bits 2k et 2k+1 tous les deux a 1).
procedure InitIQ1SGrid;
const
  grid_size = NGRID_IQ1S; // 2048
  kmap_size = IQ2_KMAP_SIZE; // 43692
  nwant = 3; // IQ1_S / IQ1_M => 3   (IQ2_S => 1, IQ2_XS/XXS => 2)
var
  k, i, j, l, index, q: Integer;
  n_per_i, offsets: TArray<Integer>;
  dist2: array of TDistEntry;
  pos: array[0..7] of ShortInt;
  pg, posPtr: PShortInt;
  aux64: UInt64;
  aux8: PByte;
  d2, cur_d2, nhave, n, counter, local_counter, start_idx: Integer;
  num_neighbors, num_not_in_map: Integer;
  code: UInt16;
begin
  if iq1s_initialized then
    Exit;

  // Lattice : octets = 2*l + 1 (l in 0..2 -> 1, 3, 5)
  SetLength(kgrid_q1s, grid_size);
  for k := 0 to grid_size - 1 do
  begin
    posPtr := PShortInt(@kgrid_q1s[k]);
    code := kgrid_1bit_2048[k];
    for i := 0 to 7 do
    begin
      l := (code shr (2 * i)) and $3;
      Assert(l <= 2, 'kgrid_1bit_2048 invalide ou incomplete (code 3)');
      posPtr[i] := ShortInt(2 * l + 1);
    end;
  end;

  // kmap : index 16 bits (8 x 2 bits, max 0xAAAA) -> index grille
  SetLength(kmap_q1s, kmap_size);
  for i := 0 to kmap_size - 1 do
    kmap_q1s[i] := -1;

  for i := 0 to grid_size - 1 do
  begin
    aux64 := kgrid_q1s[i];
    aux8 := PByte(@aux64);
    index := 0;
    for k := 0 to 7 do
    begin
      q := (ShortInt(aux8[k]) - 1) div 2;
      index := index or (q shl (2 * k));
    end;
    // Table tronquee / codes en double => piege (comme InitIQ2XSGrid)
    Assert(kmap_q1s[index] < 0, 'kgrid_1bit_2048 invalide ou incomplete (codes non distincts)');
    kmap_q1s[index] := i;
  end;

  SetLength(dist2, grid_size);

  // Nombre de voisins pour chaque point hors grille (3 premieres distances)
  SetLength(n_per_i, kmap_size);
  num_neighbors := 0;
  num_not_in_map := 0;

  for i := 0 to kmap_size - 1 do
  begin
    if kmap_q1s[i] >= 0 then
    begin
      n_per_i[i] := 0;
      Continue;
    end;
    if ((i and (i shr 1)) and $5555) <> 0 then
      Continue; // champ == 3 : jamais requete par le quantizer IQ1
    Inc(num_not_in_map);

    posPtr := @pos[0];
    for k := 0 to 7 do
    begin
      l := (i shr (2 * k)) and $3;
      posPtr[k] := ShortInt(2 * l + 1);
    end;

    for j := 0 to grid_size - 1 do
    begin
      pg := PShortInt(@kgrid_q1s[j]);
      d2 := 0;
      for k := 0 to 7 do
        d2 := d2 + (pg[k] - pos[k]) * (pg[k] - pos[k]);
      dist2[j].dist2 := d2;
      dist2[j].grid_idx := j;
    end;

    //TArray.Sort<TDistEntry>(dist2, TComparer<TDistEntry>.Construct(CompareDist));
    SortDistEntriesBucket(dist2, grid_size, 128);

    n := 0;
    cur_d2 := dist2[0].dist2;
    nhave := 1;
    for j := 0 to grid_size - 1 do
    begin
      if dist2[j].dist2 > cur_d2 then
      begin
        if nhave = nwant then
          Break;
        cur_d2 := dist2[j].dist2;
        Inc(nhave);
      end;
      Inc(n);
    end;

    n_per_i[i] := n;
    Inc(num_neighbors, n);
  end;

  // Prefix-sum des offsets + allocation
  SetLength(offsets, kmap_size);
  SetLength(kneighbors_q1s, num_neighbors + num_not_in_map);

  counter := 0;
  for i := 0 to kmap_size - 1 do
  begin
    if kmap_q1s[i] >= 0 then
    begin
      offsets[i] := -1;
      Continue;
    end;
    if ((i and (i shr 1)) and $5555) <> 0 then
    begin
      offsets[i] := -1;
      Continue;
    end;
    offsets[i] := counter;
    counter := counter + 1 + n_per_i[i];
  end;

  // Remplissage des listes de voisins
  for i := 0 to kmap_size - 1 do
  begin
    if kmap_q1s[i] >= 0 then
      Continue;
    if ((i and (i shr 1)) and $5555) <> 0 then
      Continue;

    posPtr := @pos[0];
    for k := 0 to 7 do
    begin
      l := (i shr (2 * k)) and $3;
      posPtr[k] := ShortInt(2 * l + 1);
    end;

    for j := 0 to grid_size - 1 do
    begin
      pg := PShortInt(@kgrid_q1s[j]);
      d2 := 0;
      for k := 0 to 7 do
        d2 := d2 + (pg[k] - pos[k]) * (pg[k] - pos[k]);
      dist2[j].dist2 := d2;
      dist2[j].grid_idx := j;
    end;

    //TArray.Sort<TDistEntry>(dist2, TComparer<TDistEntry>.Construct(CompareDist));
    SortDistEntriesBucket(dist2, grid_size, 128);

    local_counter := offsets[i];
    kmap_q1s[i] := -(local_counter + 1); // lecture : @kneighbors_q1s[-(v)-1]

    cur_d2 := dist2[0].dist2;
    start_idx := local_counter;
    Inc(local_counter);

    n := 0;
    nhave := 1;
    for j := 0 to grid_size - 1 do
    begin
      if dist2[j].dist2 > cur_d2 then
      begin
        if nhave = nwant then
          Break;
        cur_d2 := dist2[j].dist2;
        Inc(nhave);
      end;
      kneighbors_q1s[local_counter] := dist2[j].grid_idx;
      Inc(local_counter);
      Inc(n);
    end;
    kneighbors_q1s[start_idx] := n;
  end;

  SetLength(n_per_i, 0);
  SetLength(offsets, 0);
  iq1s_initialized := True;
end;

