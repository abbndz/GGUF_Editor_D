// ==================== MEILLEUR VOISIN IQ1 (d2 pondere, table xg) ============
// C : iq1_find_best_neighbour2().
// NB : la boucle de repli du C contient une coquille (`xval[i]` au lieu de
// `xval[j]`).  Elle n'est jamais atteinte (un voisin est toujours soluble),
// on la corrige donc ici sans consequence sur les resultats.
function FindBestNeighbourIQ1(const ANeighbors: PUInt16; const AGrid: PUInt64; const AXVal: PSingle; const AWeight:
  PSingle; AScale: Single; const AXg: PSingle; AL: PShortInt; nGrid: Integer): Integer;
var
  num_neighbors, j, i, grid_index: Integer;
  best_d2, d2, q, w, diff: Single;
  pg: PShortInt;
begin
  num_neighbors := ANeighbors[0];
  Assert(num_neighbors > 0);
  best_d2 := Single.MaxValue;
  grid_index := -1;

  for j := 1 to num_neighbors do
  begin
    pg := PShortInt(PByte(AGrid) + ANeighbors[j] * 8);
    d2 := 0.0;
    for i := 0 to 7 do
    begin
      q := AXg[(pg[i] - 1) div 2]; // x_p / x_m : 3 niveaux
      w := AWeight[i];
      diff := AScale * q - AXVal[i];
      d2 := d2 + w * diff * diff;
    end;
    if d2 < best_d2 then
    begin
      best_d2 := d2;
      grid_index := ANeighbors[j];
    end;
  end;

  if grid_index < 0 then
    for i := 0 to nGrid - 1 do
    begin
      pg := PShortInt(PByte(AGrid) + i * 8);
      d2 := 0.0;
      for j := 0 to 7 do
      begin
        w := AWeight[j];
        q := AXg[(pg[j] - 1) div 2];
        diff := AScale * q - AXVal[j]; // C : AXVal[i] (coquille)
        d2 := d2 + w * diff * diff;
      end;
      if d2 < best_d2 then
      begin
        best_d2 := d2;
        grid_index := i;
      end;
    end;

  if grid_index < 0 then
    raise EGGML.CreateFmt('IQ1FindBestNeighbour2: aucun point de grille (%d voisins)', [num_neighbors]);

  Assert(grid_index >= 0);
  pg := PShortInt(PByte(AGrid) + grid_index * 8);
  for i := 0 to 7 do
    AL[i] := (pg[i] - 1) div 2;

  Result := grid_index;
end;

// ============================ INITIALISATION GRILLE IQ3 (512) ===============
// Miroir de iq3xs_init_impl(512). Grille = IQ3S_GRID (aucune copie necessaire).
procedure InitIQ3SGrid;
const
  grid_size = 512;
  kmap_size = 4096; // 8^4 : 4 composantes de 3 bits
  nwant = 3;
var
  k, i, j, l, index, q: Integer;
  n_per_i, offsets: TArray<Integer>;
  dist2: array of TDistEntry;
  pos: array[0..3] of ShortInt;
  pg, posPtr: PShortInt;
  aux32: UInt32;
  aux8: PByte;
  d2, cur_d2, nhave, n, counter, local_counter, start_idx: Integer;
  num_neighbors, num_not_in_map: Integer;
  Grid: PUInt32;
begin
  if iq3s_initialized then
    Exit;

  Grid := PUInt32(@IQ3S_GRID[0]); // == kgrid_q3xs du C

  SetLength(kmap_q3xs, kmap_size);
  for i := 0 to kmap_size - 1 do
    kmap_q3xs[i] := -1;

  for i := 0 to grid_size - 1 do
  begin
    aux32 := Grid^;
    Inc(Grid);
    aux8 := PByte(@aux32);
    index := 0;
    for k := 0 to 3 do
    begin
      q := (aux8[k] - 1) div 2;
      index := index or (q shl (3 * k));
    end;
    kmap_q3xs[index] := i;
  end;
  Grid := PUInt32(@IQ3S_GRID[0]);

  SetLength(dist2, grid_size);

  SetLength(n_per_i, kmap_size);
  num_neighbors := 0;
  num_not_in_map := 0;

  for i := 0 to kmap_size - 1 do
  begin
    if kmap_q3xs[i] >= 0 then
    begin
      n_per_i[i] := 0;
      Continue;
    end;
    Inc(num_not_in_map);

    posPtr := @pos[0];
    for k := 0 to 3 do
    begin
      l := (i shr (3 * k)) and $7;
      posPtr[k] := 2 * l + 1;
    end;

    for j := 0 to grid_size - 1 do
    begin
      pg := PShortInt(PByte(Grid) + j * 4);
      d2 := 0;
      for k := 0 to 3 do
        d2 := d2 + (pg[k] - pos[k]) * (pg[k] - pos[k]);
      dist2[j].dist2 := d2;
      dist2[j].grid_idx := j;
    end;

    //TArray.Sort<TDistEntry>(dist2, TComparer<TDistEntry>.Construct(CompareDist));
    SortDistEntriesBucket(dist2, grid_size, 784);

    n := 0;
    cur_d2 := dist2[0].dist2;
    nhave := 1;
    for j := 0 to grid_size - 1 do
    begin
      if dist2[j].dist2 > cur_d2 then
      begin
        if nhave = nwant then
          Break;
        cur_d2 := dist2[j].dist2;
        Inc(nhave);
      end;
      Inc(n);
    end;

    n_per_i[i] := n;
    Inc(num_neighbors, n);
  end;

  SetLength(offsets, kmap_size);
  SetLength(kneighbors_q3xs, num_neighbors + num_not_in_map);

  counter := 0;
  for i := 0 to kmap_size - 1 do
  begin
    if kmap_q3xs[i] >= 0 then
    begin
      offsets[i] := -1;
      Continue;
    end;
    offsets[i] := counter;
    counter := counter + 1 + n_per_i[i];
  end;

  for i := 0 to kmap_size - 1 do
  begin
    if kmap_q3xs[i] >= 0 then
      Continue;

    posPtr := @pos[0];
    for k := 0 to 3 do
    begin
      l := (i shr (3 * k)) and $7;
      posPtr[k] := 2 * l + 1;
    end;

    for j := 0 to grid_size - 1 do
    begin
      pg := PShortInt(PByte(Grid) + j * 4);
      d2 := 0;
      for k := 0 to 3 do
        d2 := d2 + (pg[k] - pos[k]) * (pg[k] - pos[k]);
      dist2[j].dist2 := d2;
      dist2[j].grid_idx := j;
    end;

    //TArray.Sort<TDistEntry>(dist2, TComparer<TDistEntry>.Construct(CompareDist));
    SortDistEntriesBucket(dist2, grid_size, 784);

    local_counter := offsets[i];
    kmap_q3xs[i] := -(local_counter + 1);

    cur_d2 := dist2[0].dist2;
    start_idx := local_counter;
    Inc(local_counter);

    n := 0;
    nhave := 1;
    for j := 0 to grid_size - 1 do
    begin
      if dist2[j].dist2 > cur_d2 then
      begin
        if nhave = nwant then
          Break;
        cur_d2 := dist2[j].dist2;
        Inc(nhave);
      end;
      kneighbors_q3xs[local_counter] := dist2[j].grid_idx;
      Inc(local_counter);
      Inc(n);
    end;
    kneighbors_q3xs[start_idx] := n;
  end;

  SetLength(n_per_i, 0);
  SetLength(offsets, 0);
  iq3s_initialized := True;
end;

// ============================ INITIALISATION GRILLE IQ2_S ===================
procedure InitIQ2SGrid;
const
  grid_size = 1024;
  kmap_size = IQ2_KMAP_SIZE;
  nwant = 1;
var
  k, i, j, l, index, q: Integer;
  n_per_i, offsets: TArray<Integer>;
  dist2: array of TDistEntry;
  pos: array[0..7] of ShortInt;
  pg, posPtr: PShortInt;
  aux64: UInt64;
  aux8: PByte;
  d2, cur_d2, nhave, n, counter, local_counter, start_idx: Integer;
  num_neighbors, num_not_in_map: Integer;
begin
  if iq2s_initialized then
    Exit;

  SetLength(kgrid_q2xs, grid_size);
  for k := 0 to grid_size - 1 do
  begin
    posPtr := PShortInt(@kgrid_q2xs[k]);
    for i := 0 to 7 do
    begin
      l := (kgrid_2bit_1024[k] shr (2 * i)) and $3;
      posPtr[i] := 2 * l + 1;
    end;
  end;

  SetLength(kmap_q2xs, kmap_size);
  for i := 0 to kmap_size - 1 do
    kmap_q2xs[i] := -1;

  for i := 0 to grid_size - 1 do
  begin
    aux64 := kgrid_q2xs[i];
    aux8 := PByte(@aux64);
    index := 0;
    for k := 0 to 7 do
    begin
      q := (aux8[k] - 1) div 2;
      index := index or (q shl (2 * k));
    end;
    kmap_q2xs[index] := i;
  end;

  // Compter les voisins pour la recherche
  SetLength(n_per_i, kmap_size);
  SetLength(dist2, grid_size);
  num_neighbors := 0;
  num_not_in_map := 0;

  for i := 0 to kmap_size - 1 do
  begin
    if kmap_q2xs[i] >= 0 then
    begin
      n_per_i[i] := 0;
      Continue;
    end;
    Inc(num_not_in_map);

    for k := 0 to 7 do
    begin
      l := (i shr (2 * k)) and $3;
      pos[k] := 2 * l + 1;
    end;

    for j := 0 to grid_size - 1 do
    begin
      pg := PShortInt(@kgrid_q2xs[j]);
      d2 := 0;
      for k := 0 to 7 do
        d2 := d2 + (pg[k] - pos[k]) * (pg[k] - pos[k]);
      dist2[j].dist2 := d2;
      dist2[j].grid_idx := j;
    end;

    //TArray.Sort<TDistEntry>(dist2, TComparer<TDistEntry>.Construct(CompareDist));
    SortDistEntriesBucket(dist2, grid_size, 288);

    n := 0;
    cur_d2 := dist2[0].dist2;
    nhave := 1;
    for j := 0 to grid_size - 1 do
    begin
      if dist2[j].dist2 > cur_d2 then
      begin
        if nhave = nwant then
          Break;
        cur_d2 := dist2[j].dist2;
        Inc(nhave);
      end;
      Inc(n);
    end;

    n_per_i[i] := n;
    Inc(num_neighbors, n);
  end;

  // Calculer les offsets et allouer kneighbors_q2
  SetLength(offsets, kmap_size);
  SetLength(kneighbors_q2xs, num_neighbors + num_not_in_map);

  counter := 0;
  for i := 0 to kmap_size - 1 do
  begin
    if kmap_q2xs[i] >= 0 then
    begin
      offsets[i] := -1;
      Continue;
    end;
    offsets[i] := counter;
    counter := counter + 1 + n_per_i[i];
  end;

  // Remplir kneighbors_q2
  for i := 0 to kmap_size - 1 do
  begin
    if kmap_q2xs[i] >= 0 then
      Continue;

    for k := 0 to 7 do
    begin
      l := (i shr (2 * k)) and $3;
      pos[k] := 2 * l + 1;
    end;

    for j := 0 to grid_size - 1 do
    begin
      pg := PShortInt(@kgrid_q2xs[j]);
      d2 := 0;
      for k := 0 to 7 do
        d2 := d2 + (pg[k] - pos[k]) * (pg[k] - pos[k]);
      dist2[j].dist2 := d2;
      dist2[j].grid_idx := j;
    end;

    //TArray.Sort<TDistEntry>(dist2, TComparer<TDistEntry>.Construct(CompareDist));
    SortDistEntriesBucket(dist2, grid_size, 288);

    local_counter := offsets[i];
    kmap_q2xs[i] := -(local_counter + 1);

    cur_d2 := dist2[0].dist2;
    start_idx := local_counter;
    Inc(local_counter);

    n := 0;
    nhave := 1;
    for j := 0 to grid_size - 1 do
    begin
      if dist2[j].dist2 > cur_d2 then
      begin
        if nhave = nwant then
          Break;
        cur_d2 := dist2[j].dist2;
        Inc(nhave);
      end;
      kneighbors_q2xs[local_counter] := dist2[j].grid_idx;
      Inc(local_counter);
      Inc(n);
    end;
    kneighbors_q2xs[start_idx] := n;
  end;

  SetLength(n_per_i, 0);
  SetLength(offsets, 0);
  iq2s_initialized := True;
end;

